{
  "id": "fake",
  "name": "Fake Synth",
  "abbrev": "FAKE",
  "version": "1.0.0",
  "description": "A stand-in sound generator for melodee-move's tests",
  "api_version": 2,
  "component_type": "sound_generator",
  "dsp": "dsp.so",
  "capabilities": {
    "audio_out": true,
    "midi_in": true,
    "chain_params": [
      {
        "key": "level",
        "name": "Level",
        "type": "float",
        "min": 0,
        "max": 1,
        "step": 0.01,
        "default": 0.5
      },
      {
        "key": "wave",
        "name": "Wave",
        "type": "enum",
        "options": [
          "Sine",
          "Square"
        ],
        "default": "Square"
      },
      {
        "key": "voices",
        "name": "Voices",
        "type": "int",
        "min": 1,
        "max": 8,
        "default": 4
      },
      {
        "key": "preset",
        "name": "Preset",
        "type": "int",
        "min": 0,
        "max": 99,
        "max_param": "preset_count"
      },
      {
        "key": "sample",
        "name": "Sample",
        "type": "filepath"
      },
      {
        "key": "go",
        "name": "Go",
        "type": "enum",
        "options": [
          "idle",
          "trigger"
        ],
        "default": "idle"
      },
      {
        "key": "browse",
        "name": "Browse",
        "type": "canvas",
        "canvas_script": "page.js",
        "as_page": true,
        "enterable": true,
        "extra_keys": [
          "level"
        ]
      }
    ],
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "Fake",
          "list_param": "preset",
          "count_param": "preset_count",
          "name_param": "preset_name",
          "knobs": [
            "level",
            "wave",
            null,
            "voices",
            "preset"
          ],
          "params": [
            "level",
            {
              "key": "wave",
              "label": "Waveform"
            },
            {
              "level": "env",
              "label": "Envelope"
            },
            {
              "level": "tables",
              "label": "Tables"
            },
            "browse"
          ]
        },
        "env": {
          "name": "Envelope",
          "knobs": [
            "attack"
          ],
          "params": [
            {
              "key": "attack",
              "label": "Attack",
              "short_name": "ATK",
              "type": "float",
              "min": 0,
              "max": 2,
              "step": 0.01
            }
          ]
        },
        "tables": {
          "label": "Tables",
          "items_param": "table_list",
          "select_param": "table",
          "navigate_to": "root"
        }
      }
    }
  }
}
