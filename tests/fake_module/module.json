{
  "id": "fake",
  "name": "Fake Synth",
  "abbrev": "FAKE",
  "version": "1.0.0",
  "description": "A stand-in sound generator for melodee-move's tests",
  "api_version": 2,
  "component_type": "sound_generator",
  "dsp": "dsp.so",
  "capabilities": {
    "audio_out": true,
    "midi_in": true,
    "chain_params": [
      {"key": "level", "name": "Level", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.5},
      {"key": "wave", "name": "Wave", "type": "enum", "options": ["Sine", "Square"], "default": "Square"},
      {"key": "voices", "name": "Voices", "type": "int", "min": 1, "max": 8, "default": 4},
      {"key": "preset", "name": "Preset", "type": "int", "min": 0, "max": 99, "max_param": "preset_count"},
      {"key": "sample", "name": "Sample", "type": "filepath"}
    ],
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "Fake",
          "list_param": "preset",
          "count_param": "preset_count",
          "name_param": "preset_name",
          "knobs": ["level", "wave", "voices", "preset"],
          "params": [{"level": "env", "label": "Envelope"}]
        },
        "env": {
          "name": "Envelope",
          "knobs": ["attack"],
          "params": [{"key": "attack", "short_name": "ATK"}]
        }
      }
    }
  }
}
